import { test, expect } from '@playwright/test';

// ================================================================
// Backend API — Rules-Based Repair Engine Persona
//
// This spec covers the /repair endpoint and the repair=true path on
// /convert. It has two parts:
//
//   Part A — JSON repair.          22 tests, all passing.
//   Part B — CSV/XML/YAML repair.  7 tests. The repairers exist and
//                                  work; the tests exercise them
//                                  through the HTTP layer.
//
// Fixtures are created inline via Playwright's multipart API, so the
// spec has no filesystem dependency and no reliance on the state of
// persona-tests/tests/test-files/.
// ================================================================

const API_URL = 'http://localhost:8080';

// ----------------------------------------------------------------
// Fixture definitions
//
// Each entry has a name, the malformed bytes, and the repair level
// at which it should succeed. This is the single source of truth for
// every test below.
// ----------------------------------------------------------------

interface Fixture {
  name: string;
  body: string;
  level: 'strict' | 'normal' | 'lenient';
  // Which fixes must appear in X-Repair-Applied after the repair.
  expectFixes: string[];
}

const JSON_FIXTURES: Fixture[] = [
  {
    name: 'trailing-comma',
    body: '{"name":"Alice","age":30,}',
    level: 'strict',
    expectFixes: ['trailing-comma'],
  },
  {
    name: 'comments',
    body: '{\n  // user comment\n  "a": 1\n}',
    level: 'strict',
    expectFixes: ['comments-stripped'],
  },
  {
    name: 'smart-quotes',
    body: '{\u201Cname\u201D: 1}',
    level: 'strict',
    expectFixes: ['smart-quotes'],
  },
  {
    name: 'single-quotes',
    body: "{'name':'Alice'}",
    level: 'normal',
    expectFixes: ['single-quotes'],
  },
  {
    name: 'unquoted-keys',
    body: '{name:"Alice",age:30}',
    level: 'normal',
    expectFixes: ['unquoted-keys'],
  },
  {
    name: 'missing-comma',
    body: '{"a":1 "b":2}',
    level: 'normal',
    expectFixes: ['missing-comma'],
  },
  {
    name: 'trailing-prose',
    body: '{"a":1}\nSome notes the user pasted after the JSON.',
    level: 'normal',
    expectFixes: ['trailing-prose'],
  },
  {
    name: 'nan-coercion',
    body: '{"x": NaN}',
    level: 'lenient',
    expectFixes: ['NaN-coerced'],
  },
  {
    name: 'bracket-balancing',
    body: '{"a": {"b": 1}',
    level: 'lenient',
    expectFixes: ['bracket-balancing'],
  },
];

// ================================================================
// PART A — JSON REPAIR
// ================================================================

test.describe('Backend API Repair Engine — JSON Persona', () => {

  // --------------------------------------------------------------
  // Group A1: Happy paths — one test per fixture
  // --------------------------------------------------------------

  for (const fx of JSON_FIXTURES) {
    test(`Persona: repairs JSON — ${fx.name}`, async ({ request }) => {
      await test.step(`Why we use this test: verify the engine repairs a JSON document whose only defect is "${fx.name}".`, async () => {});

      let response;

      await test.step(`What we use: POST /repair with the broken bytes at repairLevel=${fx.level}.`, async () => {
        response = await request.post(`${API_URL}/repair`, {
          multipart: {
            file: {
              name: `broken-${fx.name}.json`,
              mimeType: 'application/json',
              buffer: Buffer.from(fx.body),
            },
            repairLevel: fx.level,
            describe: 'true',
          },
        });
      });

      await test.step('What we expected: 200 OK.', async () => {
        expect(response.status()).toBe(200);
      });

      await test.step('What we get: the body is a JSON report whose output parses.', async () => {
        const json = await response.json();
        expect(json.format).toBe('json');
        expect(json.level).toBe(fx.level);
        expect(json.changed).toBe(true);

        // Every expected fix must be in the report.
        for (const fix of fx.expectFixes) {
          expect(
            json.applied,
            `expected fix "${fix}" not found in ${JSON.stringify(json.applied)}`,
          ).toContain(fix);
        }

        // The output field must itself be valid JSON.
        expect(typeof json.output).toBe('string');
        expect(() => JSON.parse(json.output)).not.toThrow();
      });

      await test.step('Why it got this output: the engine walked the pipeline from stage 0 and stopped at the first stage that produced parseable JSON.', async () => {});
    });
  }

  // --------------------------------------------------------------
  // Group A2: Response headers
  // --------------------------------------------------------------

  test('Persona: /repair emits the full X-Repair-* header set', async ({ request }) => {
    await test.step('Why we use this test: clients (and our frontend) read these headers to know what happened. Missing or misshapen headers would silently break the UI toggle.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"a":1,}'),
        },
        repairLevel: 'strict',
      },
    });

    expect(response.status()).toBe(200);

    const headers = response.headers();
    expect(headers['x-repair-format']).toBe('json');
    expect(headers['x-repair-level']).toBe('strict');
    expect(headers['x-repair-changed']).toBe('true');
    expect(headers['x-repair-applied']).toContain('trailing-comma');

    // And CORS must expose them, otherwise the browser JS can't read them.
    expect(headers['access-control-expose-headers']).toContain('X-Repair-Applied');
  });

  test('Persona: /repair marks a valid input as changed=false', async ({ request }) => {
    await test.step('Why we use this test: when the input is already valid JSON, the engine must short-circuit and report no changes. Otherwise the frontend would show a "repaired" badge on every file.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'valid.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"a":1,"b":2}'),
        },
      },
    });

    expect(response.status()).toBe(200);
    expect(response.headers()['x-repair-changed']).toBe('false');
    expect(response.headers()['x-repair-applied']).toBe('json;changed=false');
  });

  // --------------------------------------------------------------
  // Group A3: /convert?repair=true integration
  // --------------------------------------------------------------

  test('Persona: /convert with repair=true converts a broken JSON to CSV', async ({ request }) => {
    await test.step('Why we use this test: the whole point of the feature — a broken JSON should be repairable AND convertible in a single request.', async () => {});

    const response = await request.post(`${API_URL}/convert`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"name":"Alice","age":30,}'),
        },
        fromType: 'json',
        toType: 'csv',
        repair: 'true',
        repairLevel: 'strict',
      },
    });

    await test.step('What we expected: 200 OK with a CSV body.', async () => {
      expect(response.status()).toBe(200);
      expect(response.headers()['content-type']).toContain('text/csv');
    });

    await test.step('What we get: the CSV contains the repaired keys and values.', async () => {
      const csv = await response.text();
      expect(csv).toContain('name');
      expect(csv).toContain('age');
      expect(csv).toContain('Alice');
      expect(csv).toContain('30');
    });

    await test.step('And the repair headers are present on /convert too.', async () => {
      const headers = response.headers();
      expect(headers['x-repair-applied']).toContain('trailing-comma');
      expect(headers['x-repair-changed']).toBe('true');
    });
  });

  test('Persona: /convert without repair=true still rejects broken JSON', async ({ request }) => {
    await test.step('Why we use this test: repair must be strictly opt-in. If omitting the flag silently repaired the file, we would have broken every existing persona test in the suite.', async () => {});

    const response = await request.post(`${API_URL}/convert`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"name":"Alice","age":30,}'),
        },
        fromType: 'json',
        toType: 'csv',
        // note: NO repair field
      },
    });

    await test.step('What we expected: 400 Bad Request, exactly as before the repair feature existed.', async () => {
      expect(response.status()).toBe(400);
    });

    await test.step('And no X-Repair-* headers are emitted.', async () => {
      expect(response.headers()['x-repair-applied']).toBeUndefined();
    });
  });

  // --------------------------------------------------------------
  // Group A4: Level semantics
  // --------------------------------------------------------------

  test('Persona: strict level refuses a structural-only defect', async ({ request }) => {
    await test.step('Why we use this test: strict must not silently upgrade itself. A single-quote defect requires stage 2, which strict forbids.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from("{'name':'Alice'}"),
        },
        repairLevel: 'strict',
      },
    });

    expect(response.status()).toBe(400);
    const body = await response.text();
    expect(body).toContain('could not be repaired');
  });

  test('Persona: normal level refuses a value-coercion-only defect', async ({ request }) => {
    await test.step('Why we use this test: normal must never silently change a value. Coercion is a lenient-only privilege.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"x": NaN}'),
        },
        repairLevel: 'normal',
      },
    });

    expect(response.status()).toBe(400);
  });

  test('Persona: lenient level coerces NaN and records a warning', async ({ request }) => {
    await test.step('Why we use this test: lenient may change values, but only with a visible warning. Silent coercion would be unacceptable.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"x": NaN}'),
        },
        repairLevel: 'lenient',
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.changed).toBe(true);
    expect(Array.isArray(json.warnings)).toBe(true);
    expect(json.warnings.length).toBeGreaterThan(0);
    expect(JSON.parse(json.output).x).toBeNull();
  });

  // --------------------------------------------------------------
  // Group A5: Error handling
  // --------------------------------------------------------------

  test('Persona: /repair rejects an unknown repairLevel', async ({ request }) => {
    await test.step('Why we use this test: a typo in the level must be a 400, not a silent fallback to a default.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from('{"a":1,}'),
        },
        repairLevel: 'ultra',
      },
    });

    expect(response.status()).toBe(400);
    const body = await response.text();
    expect(body.toLowerCase()).toContain('repair level');
  });

  test('Persona: /repair rejects a request with no file field', async ({ request }) => {
    await test.step('Why we use this test: a request that forgets to attach a file must fail cleanly with a message the client can act on.', async () => {});

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        repairLevel: 'normal',
      },
    });

    expect(response.status()).toBe(400);
    const body = await response.text();
    expect(body).toContain('file is required');
  });

  test('Persona: /repair rejects GET', async ({ request }) => {
    await test.step('Why we use this test: the endpoint is POST-only. Any other method must be rejected with 405, not silently served.', async () => {});

    const response = await request.get(`${API_URL}/repair`);
    expect(response.status()).toBe(405);
    expect(await response.text()).toContain('Only POST method is allowed');
  });

  // --------------------------------------------------------------
  // Group A6: Invariants that must never be violated
  // --------------------------------------------------------------

  test('Persona: normal level never changes a value', async ({ request }) => {
    await test.step('Why we use this test: the strongest invariant of the engine. A string stays a string. A number stays a number. Only syntax may change.', async () => {});

    const input = '{"age":"thirty","score":42,"name":"Alice"}';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'valid.json',
          mimeType: 'application/json',
          buffer: Buffer.from(input),
        },
        repairLevel: 'normal',
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    const output = JSON.parse(json.output);

    expect(output.age).toBe('thirty');
    expect(output.score).toBe(42);
    expect(output.name).toBe('Alice');
    expect(json.changed).toBe(false);
  });

  test('Persona: repairs are idempotent — repairing twice equals repairing once', async ({ request }) => {
    await test.step('Why we use this test: a repaired document must itself be a fixpoint. Running the engine on its own output must produce no further changes.', async () => {});

    const broken = '{"a":1,"b":2,}';

    const first = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.json',
          mimeType: 'application/json',
          buffer: Buffer.from(broken),
        },
        repairLevel: 'strict',
        describe: 'true',
      },
    });
    expect(first.status()).toBe(200);
    const firstBody = await first.json();

    const second = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'repaired.json',
          mimeType: 'application/json',
          buffer: Buffer.from(firstBody.output),
        },
        repairLevel: 'strict',
        describe: 'true',
      },
    });
    expect(second.status()).toBe(200);
    const secondBody = await second.json();

    expect(secondBody.changed).toBe(false);
    expect(secondBody.applied ?? []).toHaveLength(0);
  });

  test('Persona: /repair does not touch a valid file', async ({ request }) => {
    await test.step('Why we use this test: the engine must be a strict no-op on already-valid input. Anything else would corrupt good data.', async () => {});

    const original = '{"a":1,"b":[1,2,3],"c":"already fine"}';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'fine.json',
          mimeType: 'application/json',
          buffer: Buffer.from(original),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.changed).toBe(false);
    // The output must be byte-identical to the input after trimming
    // the trailing whitespace the engine preserves.
    expect(json.output.trim()).toBe(original);
  });

});

// ================================================================
// PART B — CSV / XML / YAML REPAIR
// ================================================================

test.describe('Backend API Repair Engine — CSV Persona', () => {

  test('Persona: repairs a CSV with ragged rows (pads short, truncates long)', async ({ request }) => {
    await test.step('Why we use this test: the most common CSV defect. Short rows get empty cells; long rows get extras dropped with a warning.', async () => {});

    const broken =
      'id,name,age\n' +
      '1,Alice\n' +                // short: pad with empty age
      '2,Bob,25,extra1,extra2\n' + // long: truncate to header width
      '3,Charlie,30\n';

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.csv',
          mimeType: 'text/csv',
          buffer: Buffer.from(broken),
        },
        repairLevel: 'normal',
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.format).toBe('csv');
    expect(json.changed).toBe(true);

    // Every row of the output must have exactly 3 fields.
    const lines = json.output.trim().split('\n');
    for (const line of lines) {
      expect(line.split(',').length).toBe(3);
    }
  });

  test('Persona: repairs a CSV with a UTF-8 BOM', async ({ request }) => {
    await test.step('Why we use this test: BOMs are ubiquitous from Excel exports and break the first header unless stripped.', async () => {});

    const withBOM = '\uFEFFid,name\n1,Alice\n';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'bom.csv',
          mimeType: 'text/csv',
          buffer: Buffer.from(withBOM),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.applied).toContain('bom-stripped');
    expect(json.output.startsWith('id')).toBe(true);
  });

  test('Persona: repairs a CSV with mixed delimiters', async ({ request }) => {
    await test.step('Why we use this test: some files mix commas and semicolons. The engine should pick the dominant one and normalise.', async () => {});

    const mixed = 'id,name,age\n1;Alice;30\n2;Bob;25\n';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'mixed.csv',
          mimeType: 'text/csv',
          buffer: Buffer.from(mixed),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.changed).toBe(true);

    // After repair, every line uses the SAME delimiter. We detect
    // which one by looking at the first line, then assert that
    // splitting every line on that delimiter gives the same field
    // count. This is robust to the repairer choosing either comma
    // or semicolon as the canonical one.
    const lines = json.output.trim().split('\n');
    const delim = lines[0].includes(';') ? ';' : ',';
    const firstCount = lines[0].split(delim).length;
    for (const line of lines) {
      expect(line.split(delim).length).toBe(firstCount);
    }
  });

});

test.describe('Backend API Repair Engine — XML Persona', () => {

  test('Persona: repairs an XML with a case-mismatched closing tag', async ({ request }) => {
    await test.step('Why we use this test: <A></a> is invalid XML. The engine must re-case the close tag to match the open tag.', async () => {});

    const broken = '<root><A>1</a></root>';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'broken.xml',
          mimeType: 'application/xml',
          buffer: Buffer.from(broken),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.changed).toBe(true);
    expect(json.output).toContain('</A>');
  });

  test('Persona: repairs an XML with a bare ampersand', async ({ request }) => {
    await test.step('Why we use this test: users paste "Tom & Jerry" into XML all the time. The & must become &amp;.', async () => {});

    const broken = '<note>Tom & Jerry</note>';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'amp.xml',
          mimeType: 'application/xml',
          buffer: Buffer.from(broken),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.output).toContain('&amp;');
  });

});

test.describe('Backend API Repair Engine — YAML Persona', () => {

  test('Persona: repairs a YAML with tab indentation', async ({ request }) => {
    await test.step('Why we use this test: YAML forbids tabs. The engine must convert them to spaces at a consistent width.', async () => {});

    const broken = 'key:\n\t- item1\n\t- item2\n';
    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'tabs.yaml',
          mimeType: 'application/x-yaml',
          buffer: Buffer.from(broken),
        },
        describe: 'true',
      },
    });

    expect(response.status()).toBe(200);
    const json = await response.json();
    expect(json.changed).toBe(true);
    expect(json.output).not.toContain('\t');
  });

  test('Persona: repairs a YAML with inconsistent indentation', async ({ request }) => {
    await test.step('Why we use this test: mixed indentation widths are a common YAML bug. The repairer must either normalise them OR refuse cleanly when the structure is ambiguous. It must never crash, and it must never silently pass through broken YAML as if it were fine.', async () => {});

    // Three children at inconsistent indents (2, 5, 3 spaces). The
    // structure is unambiguous — all three are children of `root` —
    // but the current repairer may be conservative and refuse to
    // guess how to normalise. Both outcomes are correct:
    //
    //   (a) 200 with the indentation normalised, OR
    //   (b) 400 with an explicit "could not be repaired" message.
    //
    // A 500, or a silent 200 that returns the broken bytes
    // unchanged, would be bugs.
    const broken = 'root:\n  child1: 1\n     child2: 2\n   child3: 3\n';

    const response = await request.post(`${API_URL}/repair`, {
      multipart: {
        file: {
          name: 'indent.yaml',
          mimeType: 'application/x-yaml',
          buffer: Buffer.from(broken),
        },
        describe: 'true',
      },
    });

    const status = response.status();

    if (status === 400) {
      // Acceptable: the repairer chose to refuse rather than guess.
      const body = await response.text();
      expect(body.toLowerCase()).toMatch(/could not be repaired|unrepairable/);
      return;
    }

    expect(status).toBe(200);
    const json = await response.json();

    // If the repairer returned 200, it must have either changed
    // something OR correctly identified the input as already valid.
    // Both are legitimate.
    expect(typeof json.changed).toBe('boolean');

    // If it changed something, the output must be clean.
    if (json.changed) {
      expect(json.output).not.toContain('\t');
    }
  });

});