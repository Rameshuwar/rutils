                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Age Result",
                        "schema": {
                            "$ref": "#/definitions/converter.AgeCalculationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/calculate-bmi": {
            "post": {
                "description": "Calculates Body Mass Index (BMI) based on weight and height",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
